<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebViewLoginSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WebViewLoginSpike"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation/design">

    <Grid x:Name="RootGrid" Background="{StaticResource BrandBgBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="ToggleDiagnostics_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar (48px, chỉ giữ lại nút thật sự cần dùng thường xuyên — xem báo cáo UX/UI 2026-09-24) -->
        <Grid x:Name="Toolbar"
              Grid.Row="0"
              Height="48"
              Padding="12,0"
              Background="{StaticResource BrandSurfaceBrush}"
              BorderBrush="{StaticResource BrandBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Wordmark: kara (mic/voice, pink) liền mimeh (hub ecosystem, cyan) -->
            <TextBlock Grid.Column="0"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"><Run Text="kara" Foreground="{StaticResource BrandPinkBrush}" /><Run Text="mimeh" Foreground="{StaticResource BrandCyanBrush}" /></TextBlock>

            <!-- Điều hướng: icon-only, Back/Forward tự vô hiệu khi không còn lịch sử -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="40" Height="36" Padding="0"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="Quay lại"
                        AutomationProperties.Name="Quay lại">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Button x:Name="ForwardButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="40" Height="36" Padding="0"
                        IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        Click="ForwardButton_Click"
                        ToolTipService.ToolTip="Tiến"
                        AutomationProperties.Name="Tiến">
                    <FontIcon Glyph="&#xE72A;" FontSize="16" />
                </Button>
                <Button x:Name="ReloadButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="40" Height="36" Padding="0"
                        Click="ReloadButton_Click"
                        ToolTipService.ToolTip="Tải lại"
                        AutomationProperties.Name="Tải lại">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button x:Name="HomeButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="40" Height="36" Padding="0"
                        Click="HomeButton_Click"
                        ToolTipService.ToolTip="Trang chủ YouTube"
                        AutomationProperties.Name="Trang chủ YouTube">
                    <FontIcon Glyph="&#xE80F;" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Tài khoản: chỉ 1 trong 2 hiển thị tại một thời điểm -->
            <Button x:Name="SignInButton"
                    Grid.Column="3"
                    Content="Đăng nhập YouTube"
                    Style="{StaticResource BrandPrimaryButtonStyle}"
                    Click="SignInButton_Click"
                    Visibility="{x:Bind InvertBoolToVis(ViewModel.IsSignedIn), Mode=OneWay}" />

            <DropDownButton x:Name="AccountDropDown"
                            Grid.Column="3"
                            Height="36"
                            Padding="4,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="{x:Bind BoolToVis(ViewModel.IsSignedIn), Mode=OneWay}"
                            AutomationProperties.Name="Tài khoản">
                <DropDownButton.Content>
                    <PersonPicture Width="28" Height="28" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Đã đăng nhập YouTube" IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SignOutMenuItem" Text="Đăng xuất…" Click="SignOutMenuItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <InfoBar x:Name="WarningInfoBar"
                 Grid.Row="1"
                 Margin="12,8,12,0"
                 CornerRadius="8"
                 Severity="{x:Bind ViewModel.WarningSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Warning, Mode=OneWay}"
                 IsOpen="{x:Bind HasWarning(ViewModel.Warning), Mode=OneWay}"
                 IsClosable="True"
                 Closed="WarningInfoBar_Closed" />

        <!-- WebView2 + trạng thái đang tải -->
        <Grid Grid.Row="2">
            <controls:WebView2 x:Name="WebView" />

            <StackPanel Orientation="Vertical"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Đang tải YouTube…"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Bảng chẩn đoán: chỉ dành cho dev (mặc định ẩn ở Release, Ctrl+Shift+D để bật/tắt) -->
        <Border x:Name="StatusBar"
                Grid.Row="3"
                Padding="8,4"
                Background="{StaticResource BrandSurfaceBrush}"
                BorderBrush="{StaticResource BrandBorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind BoolToVis(ViewModel.IsDiagnosticsVisible), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{x:Bind FormatRuntime(ViewModel.RuntimeVersion), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind FormatPid(ViewModel.BrowserPid), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind FormatUdf(ViewModel.UserDataFolder), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <TextBlock Text="{x:Bind FormatUrl(ViewModel.CurrentUrl), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <Button Content="Sao chép"
                        Style="{StaticResource SubtleButtonStyle}"
                        Height="28" Padding="8,0"
                        Click="CopyDiagnostics_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>KaraokeMixer.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\karamimeh.ico</ApplicationIcon>
    <AssemblyName>karamimeh</AssemblyName>
    <Version>0.1.0-beta</Version>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaraokeMixer.Core\KaraokeMixer.Core.csproj" />
  </ItemGroup>

  <!-- BUG FIX: dotnet publish (unpackaged, WindowsPackageType=None) không copy $(AssemblyName).pri
       vào thư mục publish dù build thường (bin\) vẫn sinh ra file này đầy đủ. Thiếu file này khiến
       WinUI3 thỉnh thoảng (không phải lúc nào cũng) fail-fast 0xC000027B ngay khi khởi tạo XAML —
       xác nhận bằng WinDbg: MRM.dll báo "The system cannot find the file specified" khi tìm resource
       index của chính app, ngay trước khi Microsoft.UI.Xaml.dll ném lỗi và process bị kill. -->
  <Target Name="CopyAppPriToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_AppPriFile Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPriFile)" DestinationFolder="$(PublishDir)" Condition="'@(_AppPriFile)' != ''" />
  </Target>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KaraokeMixer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KaraokeMixer.App"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation/design">

    <Grid x:Name="RootGrid" Background="{StaticResource BrandBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: wordmark + WebView2 navigation + sign-in/out (carried over from WebViewLoginSpike) -->
        <Grid x:Name="Toolbar"
              Grid.Row="0"
              Height="48"
              Padding="12,0"
              Background="{StaticResource BrandSurfaceBrush}"
              BorderBrush="{StaticResource BrandBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"><Run Text="kara" Foreground="{StaticResource BrandPinkBrush}" /><Run Text="mimeh" Foreground="{StaticResource BrandCyanBrush}" /></TextBlock>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Button x:Name="BackButton" Width="40" Height="36" Padding="0"
                        Click="BackButton_Click" ToolTipService.ToolTip="Quay lại"
                        AutomationProperties.Name="Quay lại">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Button x:Name="ForwardButton" Width="40" Height="36" Padding="0"
                        Click="ForwardButton_Click" ToolTipService.ToolTip="Tiến"
                        AutomationProperties.Name="Tiến">
                    <FontIcon Glyph="&#xE72A;" FontSize="16" />
                </Button>
                <Button x:Name="ReloadButton" Width="40" Height="36" Padding="0"
                        Click="ReloadButton_Click" ToolTipService.ToolTip="Tải lại"
                        AutomationProperties.Name="Tải lại">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button x:Name="HomeButton" Width="40" Height="36" Padding="0"
                        Click="HomeButton_Click" ToolTipService.ToolTip="Trang chủ YouTube"
                        AutomationProperties.Name="Trang chủ YouTube">
                    <FontIcon Glyph="&#xE80F;" FontSize="16" />
                </Button>
            </StackPanel>

            <Button x:Name="SignInButton"
                    Grid.Column="3"
                    Content="Đăng nhập YouTube"
                    Style="{StaticResource BrandPrimaryButtonStyle}"
                    Click="SignInButton_Click"
                    Visibility="{x:Bind InvertBoolToVis(ViewModel.IsSignedIn), Mode=OneWay}" />

            <DropDownButton x:Name="AccountDropDown"
                            Grid.Column="3"
                            Height="36"
                            Padding="4,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="{x:Bind BoolToVis(ViewModel.IsSignedIn), Mode=OneWay}"
                            AutomationProperties.Name="Tài khoản">
                <DropDownButton.Content>
                    <PersonPicture Width="28" Height="28" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Đã đăng nhập YouTube" IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SignOutMenuItem" Text="Đăng xuất…" Click="SignOutMenuItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <InfoBar x:Name="WarningInfoBar"
                 Grid.Row="1"
                 Margin="12,8,12,0"
                 CornerRadius="8"
                 Severity="{x:Bind ViewModel.WarningSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Warning, Mode=OneWay}"
                 IsOpen="{x:Bind HasWarning(ViewModel.Warning), Mode=OneWay}"
                 IsClosable="True"
                 Closed="WarningInfoBar_Closed" />

        <!-- Content: WebView2 (left) + mixer control panel (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <controls:WebView2 x:Name="WebView" />

                <StackPanel Orientation="Vertical" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Đang tải YouTube…" FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Mixer control panel: functional first pass, not a final UX redesign (see task notes) -->
            <ScrollViewer Grid.Column="1"
                          Background="{StaticResource BrandSurfaceBrush}"
                          BorderBrush="{StaticResource BrandBorderBrush}"
                          BorderThickness="1,0,0,0"
                          Padding="16">
                <StackPanel Spacing="18">

                    <!-- Start/Stop + status -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bộ trộn karaoke" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button x:Name="StartStopButton"
                                Content="Bắt đầu"
                                Style="{StaticResource BrandPrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="StartStopButton_Click" />
                        <TextBlock Text="{x:Bind FormatStatus(ViewModel.EngineStatus), Mode=OneWay}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Mic device picker -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Thiết bị micro" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="MicDeviceComboBox"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.MicDevices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMicDevice, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Output device picker -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Thiết bị loa/tai nghe (output)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="OutputDeviceComboBox"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.OutputDevices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedOutputDevice, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Peak meters -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Mức tín hiệu" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Mic" FontSize="11" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <Border Height="8" CornerRadius="4" Background="{StaticResource SurfaceAltBrush}" HorizontalAlignment="Stretch">
                                <Border x:Name="MicPeakBar" Height="8" CornerRadius="4" Background="{StaticResource BrandCyanBrush}"
                                        HorizontalAlignment="Left" Width="0" />
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Master (chỉ tính nhánh mic — nhạc YouTube phát thẳng, Windows tự trộn)" FontSize="11" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <Border Height="8" CornerRadius="4" Background="{StaticResource SurfaceAltBrush}" HorizontalAlignment="Stretch">
                                <Border x:Name="MasterPeakBar" Height="8" CornerRadius="4" Background="{StaticResource BrandPinkBrush}"
                                        HorizontalAlignment="Left" Width="0" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Volumes -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Âm lượng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatPercent('Mic', ViewModel.MicVolumePercent), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="200"
                                    Value="{x:Bind ViewModel.MicVolumePercent, Mode=TwoWay}"
                                    ValueChanged="MicVolumeSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatPercent('Nhạc (YouTube, chỉnh thẳng session Windows)', ViewModel.MusicVolumePercent), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100"
                                    Value="{x:Bind ViewModel.MusicVolumePercent, Mode=TwoWay}"
                                    ValueChanged="MusicVolumeSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>

                    <!-- EQ -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="EQ 3 dải (mic)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatDb('Low', ViewModel.EqLowDb), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EqLowSlider" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.EqLowDb, Mode=TwoWay}"
                                    ValueChanged="EqLowSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatDb('Mid', ViewModel.EqMidDb), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EqMidSlider" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.EqMidDb, Mode=TwoWay}"
                                    ValueChanged="EqMidSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatDb('High', ViewModel.EqHighDb), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EqHighSlider" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.EqHighDb, Mode=TwoWay}"
                                    ValueChanged="EqHighSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Echo -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vang (Echo)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="EchoToggle" Grid.Column="1"
                                          OnContent="" OffContent=""
                                          IsOn="{x:Bind ViewModel.EchoEnabled, Mode=TwoWay}"
                                          Toggled="EchoToggle_Toggled" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatMs('Delay', ViewModel.EchoDelayMs), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EchoDelaySlider" Minimum="1" Maximum="2000" StepFrequency="10"
                                    Value="{x:Bind ViewModel.EchoDelayMs, Mode=TwoWay}"
                                    ValueChanged="EchoDelaySlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatPercent('Feedback', ViewModel.EchoFeedbackPercent), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EchoFeedbackSlider" Minimum="0" Maximum="95" StepFrequency="1"
                                    Value="{x:Bind ViewModel.EchoFeedbackPercent, Mode=TwoWay}"
                                    ValueChanged="EchoFeedbackSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind FormatPercent('Mix', ViewModel.EchoMixPercent), Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Slider x:Name="EchoMixSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                    Value="{x:Bind ViewModel.EchoMixPercent, Mode=TwoWay}"
                                    ValueChanged="EchoMixSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
